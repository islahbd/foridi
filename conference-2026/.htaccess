# Optional, for Apache/cPanel hosting: compress text files and let browsers cache the 3D files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html application/json application/javascript text/css
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
AddType application/json .json
